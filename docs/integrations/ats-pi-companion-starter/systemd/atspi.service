[Unit]
Description=ATS-Pi companion service (ASCO transfer switch → Modbus TCP)
Documentation=https://github.com/SethMorrowSoftware/ats-pi-companion
After=network-online.target
Wants=network-online.target

[Service]
# Note on Type=simple + WatchdogSec: WatchdogSec only fires when the
# service calls sd_notify(WATCHDOG=1) periodically — which requires
# Type=notify. The starter intentionally ships Type=simple because the
# reference __main__.py doesn't (yet) call sd_notify. Switch both
# together when the watchdog notify path lands.
Type=simple
User=atspi
Group=atspi
WorkingDirectory=/var/lib/atspi
ExecStart=/usr/local/bin/atspi --config /etc/atspi/config.yaml
Restart=on-failure
RestartSec=5

# Process management
TimeoutStartSec=30s
TimeoutStopSec=15s

# ── Sandboxing: least privilege ───────────────────────────────────────
# Same posture as GenWatch's genwatch.service so a downstream operator
# who reads BOTH units sees the same shape. Customize only where the
# ATS-Pi workload genuinely differs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Drop all capabilities. Default config binds to port 5020 (high port,
# no CAP_NET_BIND_SERVICE needed). If you flip to port 502 for
# convention-matching, ADD `AmbientCapabilities=CAP_NET_BIND_SERVICE`
# and `CapabilityBoundingSet=CAP_NET_BIND_SERVICE` here — never run
# the service as root just to bind a low port.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
OOMScoreAdjust=-100

# Resource caps — the ATS-Pi service is much smaller than GenWatch
# (no SQLite, no telemetry buffer, just an I/O sampler + Modbus TCP
# server). 256 MB is generous; tighten further if running on a Pi Zero.
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024

# Read-write paths
ReadWritePaths=/var/lib/atspi

# ── Device access (only when driver != mock) ──────────────────────────
# ADAM-6060 is networked; no /dev access required for that path.
# If a future driver uses local I/O (GPIO, USB), add specific
# DeviceAllow lines here — never PrivateDevices=no without scoping.

# Logging — journal-friendly
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atspi

[Install]
WantedBy=multi-user.target
