[Unit]
Description=GenWatch — Generac H-100 monitoring & control
Documentation=https://github.com/sethmorrowsoftware/genwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genwatch
Group=dialout
WorkingDirectory=/opt/genwatch

# Config + secrets live in /etc/genwatch.
Environment=GENWATCH_CONFIG_PATH=/etc/genwatch/config.yaml
Environment=GENWATCH_DATA_DIR=/var/lib/genwatch
Environment=GENWATCH_UI_DIR=/usr/share/genwatch/ui
Environment=GENWATCH_HOST=0.0.0.0
Environment=GENWATCH_PORT=8000
Environment=GENWATCH_LOG_LEVEL=info
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/genwatch/venv/bin/python -m genwatch serve

# Reliability: restart on any failure, exponential backoff.
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

# Watchdog: systemd will kill -KILL and restart if main loop hangs.
WatchdogSec=120

# Hardening — least privilege.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
PrivateDevices=no              # need /dev/ttyUSB0
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/ttyUSB1 rw
DeviceAllow=/dev/serial0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Read-write paths
ReadWritePaths=/var/lib/genwatch /etc/genwatch /var/log/genwatch

# Resource caps (Pi 4 has 4 GB)
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genwatch

[Install]
WantedBy=multi-user.target
