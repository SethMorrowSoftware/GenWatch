# GenWatch — stable symlink for the USB-RS485 adapter.
#
# When this file is installed at /etc/udev/rules.d/99-genwatch-rs485.rules,
# any supported RS-485 adapter plugged into the Pi gets symlinked to
#   /dev/genwatch-rs485
# regardless of which /dev/ttyUSB<n> slot Linux assigned it. Point your
# config.yaml at /dev/genwatch-rs485 and reboots / re-plugging won't
# break things.
#
# Apply changes without rebooting:
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Supported chipsets:
#   - FTDI FT232 / FT231X / FT4232 family   (VID 0403)
#   - WCH CH340 / CH341                     (VID 1a86)
#   - Silicon Labs CP2102 / CP2104          (VID 10c4)
#   - Prolific PL2303                       (VID 067b)
#
# If your adapter isn't in this list, run `lsusb` while it's plugged in
# to find its VID:PID and add a matching line.

# FTDI FT232 (most common)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
# FTDI FT232H
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
# FTDI FT231X
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
# FTDI FT4232H (1st port)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"

# WCH CH340/CH341
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="5523", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"

# Silicon Labs CP210x
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea70", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"

# Prolific PL2303
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23a3", SYMLINK+="genwatch-rs485", MODE="0660", GROUP="dialout"
